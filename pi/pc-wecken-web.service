[Unit]
Description=Startzentrale (Wake-on-LAN Weboberflaeche)
After=network-online.target
Wants=network-online.target

[Service]
User=admin
Environment=PORT=80
ExecStart=/usr/bin/python3 /usr/local/bin/pc-wecken-web
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
