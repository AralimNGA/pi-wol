#!/usr/bin/env python3
"""Weboberflaeche fuer pc-wecken: Start-Knopf mit Klappe je Geraet (Port 80).

Schutz (keine Benutzer-Anmeldung, siehe README):
- Host-Pruefung gegen DNS-Rebinding: nur IP-Adressen, localhost, der eigene Hostname
  (auch <name>.local und MagicDNS <name>.<tailnet>.ts.net) und PCW_HOSTS (kommagetrennt).
- POST /api/an|aus/<id> nur mit Header "X-PCW: 1" (fremde Webseiten koennen ihn ohne
  CORS-Freigabe nicht setzen) und, falls der Browser einen Origin mitschickt, nur same-origin.
"""
import importlib.machinery
import ipaddress
import json
import os
import socket
import sys
from urllib.parse import urlsplit
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PCW_PFAD = os.environ.get("PCW_PFAD", "/usr/local/bin/pc-wecken")
WEB_DIR = os.path.realpath(os.environ.get("PCW_WEB", "/usr/local/share/pc-wecken/web"))
TYPEN = {".html": "text/html; charset=utf-8", ".js": "text/javascript; charset=utf-8",
         ".css": "text/css; charset=utf-8", ".svg": "image/svg+xml", ".png": "image/png",
         ".woff2": "font/woff2", ".json": "application/json"}
PORT = int(os.environ.get("PORT", "80"))
BIND = os.environ.get("PCW_BIND", "")
HOSTNAME = socket.gethostname().split(".")[0].lower()
EXTRA_HOSTS = {h.strip().lower() for h in os.environ.get("PCW_HOSTS", "").split(",") if h.strip()}

pcw = importlib.machinery.SourceFileLoader("pcw", PCW_PFAD).load_module()

_status = {}
_lock = threading.Lock()


def _status_schleife():
    with ThreadPoolExecutor(max_workers=8) as pool:
        while True:
            try:
                liste = pcw.geraete()
                ergebnisse = dict(zip([g["id"] for g in liste], pool.map(pcw.wach, liste)))
                with _lock:
                    _status.clear()
                    _status.update(ergebnisse)
            except Exception as e:  # Geraetedatei kaputt o.ae. -> weiterlaufen
                sys.stderr.write(f"Statusfehler: {e}\n")
            time.sleep(3)


def _liste():
    with _lock:
        st = dict(_status)
    return [{"id": g["id"], "name": g["name"], "info": g.get("info", ""),
             "wach": st.get(g["id"]), "kann_aus": bool(g.get("ssh"))} for g in pcw.geraete()]


def _hostname(wert):
    """'pi-wol.local:80' -> 'pi-wol.local', '[fd7a::1]:80' -> 'fd7a::1' (ohne Port, klein)."""
    try:
        return (urlsplit("//" + (wert or "").strip()).hostname or "").lower()
    except ValueError:
        return ""


def host_erlaubt(host):
    if not host:
        return False
    try:
        ipaddress.ip_address(host)
        return True                       # Zugriff ueber IP (LAN oder Tailscale 100.x)
    except ValueError:
        pass
    if host in EXTRA_HOSTS or host in ("localhost", HOSTNAME):
        return True
    return host.startswith(HOSTNAME + ".") and (host.endswith(".local") or host.endswith(".ts.net"))


class Handler(BaseHTTPRequestHandler):
    def _host_ok(self):
        if host_erlaubt(_hostname(self.headers.get("Host"))):
            return True
        self._antwort(421, "text/plain", "Host nicht erlaubt")
        return False

    def _antwort(self, code, typ, data):
        if isinstance(data, str):
            data = data.encode()
        self.send_response(code)
        self.send_header("Content-Type", typ)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def _json(self, code, obj):
        self._antwort(code, "application/json", json.dumps(obj))

    def _datei(self, pfad):
        rel = pfad.split("?", 1)[0].lstrip("/") or "index.html"
        ziel = os.path.realpath(os.path.join(WEB_DIR, rel))
        typ = TYPEN.get(os.path.splitext(ziel)[1])
        if not ziel.startswith(WEB_DIR + os.sep) or not typ or not os.path.isfile(ziel):
            return self._antwort(404, "text/plain", "nicht gefunden")
        with open(ziel, "rb") as f:
            self._antwort(200, typ, f.read())

    def do_GET(self):
        if not self._host_ok():
            return
        if self.path.split("?", 1)[0] == "/api/geraete":
            self._json(200, _liste())
        else:
            self._datei(self.path)

    def do_POST(self):
        if not self._host_ok():
            return
        teile = self.path.strip("/").split("/")
        if len(teile) != 3 or teile[0] != "api" or teile[1] not in ("an", "aus"):
            return self._antwort(404, "text/plain", "nicht gefunden")
        origin = self.headers.get("Origin")
        if self.headers.get("X-PCW") != "1" or (
                origin is not None and _hostname(urlsplit(origin).netloc) != _hostname(self.headers.get("Host"))):
            return self._json(403, {"ok": False, "text": "Anfrage abgelehnt (fremde Herkunft)"})
        try:
            g = pcw.geraet(teile[2])
        except KeyError:
            return self._json(404, {"ok": False, "text": "Unbekanntes Geraet"})
        if teile[1] == "an":
            pcw.wecken(g)
            return self._json(200, {"ok": True, "text": "Magic Packet gesendet"})
        ok, text = pcw.ausschalten(g)
        return self._json(200 if ok else 500, {"ok": ok, "text": text})

    def log_message(self, fmt, *args):
        sys.stderr.write("%s %s\n" % (self.address_string(), fmt % args))


if __name__ == "__main__":
    threading.Thread(target=_status_schleife, daemon=True).start()
    ThreadingHTTPServer((BIND, PORT), Handler).serve_forever()
