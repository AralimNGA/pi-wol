#!/usr/bin/env python3
"""pc-wecken: Geraete per Wake-on-LAN starten, per SSH herunterfahren, Status pruefen.

  pc-wecken                    Liste aller Geraete mit Status
  pc-wecken an <id> [--warten] Magic Packet senden (optional bis zu 3 Min. warten)
  pc-wecken aus <id>           per SSH herunterfahren (falls "ssh" gesetzt)
  pc-wecken status <id>        Exit 0 = wach

Geraete stehen in /etc/pc-wecken/geraete.json (Pfad per PCW_GERAETE ueberschreibbar,
Vorlage: geraete.example.json). Broadcast-Adresse(n) je Geraet im Feld "broadcast"
oder global per PCW_BROADCAST (kommagetrennt); 255.255.255.255 wird immer mitgesendet.
"""
import ipaddress
import json
import os
import shutil
import socket
import subprocess
import sys
import time

GERAETE_PFAD = os.environ.get("PCW_GERAETE", "/etc/pc-wecken/geraete.json")
BROADCAST_GLOBAL = [b.strip() for b in os.environ.get("PCW_BROADCAST", "").split(",") if b.strip()]
SSH_KEY = os.path.expanduser("~/.ssh/id_ed25519")


def geraete():
    with open(GERAETE_PFAD, encoding="utf-8") as f:
        return json.load(f)


def geraet(gid):
    for g in geraete():
        if g["id"] == gid:
            return g
    raise KeyError(f"Unbekanntes Geraet: {gid}")


def magic_packet(mac):
    raw = bytes.fromhex(mac.replace(":", "").replace("-", ""))
    if len(raw) != 6:
        raise ValueError(f"Ungueltige MAC: {mac}")
    return b"\xff" * 6 + raw * 16


def broadcasts(g):
    """Zieladressen fuer das Magic Packet: Netz-Broadcast aus der Konfiguration + 255.255.255.255."""
    eigene = g.get("broadcast") or []
    if isinstance(eigene, str):
        eigene = [eigene]
    ziele = []
    for b in list(eigene) + BROADCAST_GLOBAL + ["255.255.255.255"]:
        if b not in ziele:
            ziele.append(b)
    return ziele


def wecken(g):
    paket = magic_packet(g["mac"])
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        for ziel in broadcasts(g):
            for port in (9, 7):
                try:
                    s.sendto(paket, (ziel, port))
                except OSError:
                    pass


def _tcp(ip, port, timeout=1.0):
    try:
        with socket.create_connection((ip, port), timeout=timeout):
            return True
    except OSError:
        return False


_ts_cache = {"t": 0.0, "peers": {}}


def _tailscale_peers():
    """Tailscale-Peers nach 100.x-IP, 2 s gecacht. Leer, wenn Tailscale fehlt oder nicht laeuft."""
    if time.monotonic() - _ts_cache["t"] < 2:
        return _ts_cache["peers"]
    peers = {}
    try:
        r = subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True, timeout=4)
        for p in json.loads(r.stdout).get("Peer", {}).values():
            for ip in p.get("TailscaleIPs") or []:
                peers[ip] = p
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    _ts_cache.update(t=time.monotonic(), peers=peers)
    return peers


def lan_ip(g):
    """Aktuelle LAN-IP: aus Tailscale gelernt (Router vergibt per DHCP neu), sonst aus geraete.json."""
    cur = (_tailscale_peers().get(g.get("ts_ip")) or {}).get("CurAddr") or ""
    try:
        ip = ipaddress.ip_address(cur.rsplit(":", 1)[0])
    except ValueError:
        return g.get("lan_ip")
    # Nur private IPv4 (10/8, 172.16/12, 192.168/16) gilt als LAN; Tailscale-100.x ist nicht "private".
    return str(ip) if ip.version == 4 and ip.is_private and not (ip.is_loopback or ip.is_link_local) else g.get("lan_ip")


def wach(g):
    # Tailscale "Online" ist am zuverlaessigsten (laeuft auf dem PC im Dauerbetrieb, auch ohne Anmeldung).
    if (_tailscale_peers().get(g.get("ts_ip")) or {}).get("Online"):
        return True
    # Windows-Firewall blockt im LAN-Profil "Oeffentlich" Ping und SSH. Ueber Tailscale
    # (Profil "Privat") ist SSH/RDP offen, RDP auch im LAN, und ARP beantwortet die Netzwerkkarte immer.
    ip_lan = lan_ip(g)
    for ip in filter(None, [g.get("ts_ip"), ip_lan]):
        for port in (22, 3389):
            if _tcp(ip, port):
                return True
    if ip_lan and shutil.which("arping"):
        r = subprocess.run(["arping", "-c", "1", "-w", "1", ip_lan],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return r.returncode == 0
    return False


def ausschalten(g):
    if not g.get("ssh"):
        return False, "Fuer dieses Geraet ist kein SSH-Zugang eingerichtet"
    cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=6",
           "-o", "StrictHostKeyChecking=accept-new", g["ssh"], g.get("aus_befehl", "shutdown /s /t 5")]
    if os.path.exists(SSH_KEY):
        cmd[1:1] = ["-i", SSH_KEY]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
    if r.returncode == 0:
        return True, "Herunterfahren ausgeloest"
    return False, (r.stderr.strip().splitlines() or ["SSH fehlgeschlagen"])[-1]


def main(args):
    if not args:
        for g in geraete():
            print(f"{g['id']:10} {g['name']:12} {'wach' if wach(g) else 'aus'}")
        return 0
    befehl, gid = args[0], (args[1] if len(args) > 1 else None)
    if gid is None:
        print(__doc__)
        return 2
    g = geraet(gid)
    if befehl == "status":
        ok = wach(g)
        print(f"{g['name']}: {'wach' if ok else 'aus / Ruhezustand'}")
        return 0 if ok else 1
    if befehl == "an":
        wecken(g)
        print(f"Magic Packet an {g['name']} ({g['mac']}) gesendet")
        if "--warten" in args:
            for _ in range(36):
                time.sleep(5)
                if wach(g):
                    print(f"{g['name']} ist wach")
                    return 0
            print("Keine Antwort nach 3 Minuten")
            return 1
        return 0
    if befehl == "aus":
        ok, text = ausschalten(g)
        print(text)
        return 0 if ok else 1
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
